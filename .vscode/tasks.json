{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PreTeXt: Build web",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/pretext",
      "args": [
        "build",
        "web"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "PreTeXt: View web",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/pretext",
      "args": [
        "view",
        "web"
      ],
      "problemMatcher": []
    },
    {
      "label": "PreTeXt: Export LaTeX",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/pretext",
      "args": [
        "build",
        "latex"
      ],
      "problemMatcher": []
    },
    {
      "label": "PreTeXt: Auto compile and preview",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "${workspaceFolder}/tools/live_preview.py"
      ],
      "isBackground": true,
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen",
        "instanceLimit": 1
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      }
    }
  ]
}
